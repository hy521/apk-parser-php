{
  "name": "evozi/apk-parser-php",
  "type": "library",
  "description": "Read basic info about android application from .apk file.",
  "keywords": [
    "apk",
    "parser",
    "android"
  ],
  "homepage": "https://github.com/evozi/apk-parser-php",
  "support": {
    "email": "email@evozi.com",
    "issues": "https://github.com/evozi/apk-parser-php/issues",
    "source": "https://github.com/evozi/apk-parser-php"
  },
  "license": "MIT",
  "authors": [
    {
      "name": "Evozi",
      "email": "email@evozi.com",
      "homepage": "http://www.evozi.com",
      "role": "Developer"
    },
    {
      "name": "Tufan Baris YILDIRIM",
      "email": "tufanbarisyildirim@gmail.com",
      "homepage": "http://tufanbarisyildirim.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-simplexml": "*",
    "ext-json": "*",
    "ext-libxml": "*",
    "ext-mbstring": "*",
    "ext-zip": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "ApkParser\\": "lib/ApkParser/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint:php": "find lib test -name '*.php' -print0 | xargs -0 -n1 php -l"
  }
}
